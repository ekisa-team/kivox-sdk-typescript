{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "import"],
  "env": {
    "builtin": true,
    "es2026": true,
    "node": true
  },
  "options": {
    "typeAware": true
  },
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "pedantic": "off",
    "style": "off",
    "restriction": "off"
  },
  "rules": {
    "typescript/no-explicit-any": "warn",
    "typescript/no-floating-promises": "error",
    "no-console": "off"
  },
  "ignorePatterns": ["dist/**", "src/codegen/**", "node_modules/**"]
}
